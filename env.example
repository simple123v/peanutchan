# Set these in Railway Variables. This file is documentation; it is not auto-loaded.
DISCORD_TOKEN=replace_with_bot_token
DISCORD_GUILD_ID=replace_with_server_id
DISCORD_OWNER_ID=replace_with_your_discord_user_id
# Required identifying User-Agent: applicationName/version realContactInfo
VRCHAT_USER_AGENT=AvatarWatch/0.1 your-real-contact@example.com
# Optional: restrict login to this exact VRChat account ID; otherwise first login binds it.
VRCHAT_USER_ID=
DATA_DIR=/data
CHECK_INTERVAL_SECONDS=90
DISCOVERY_INTERVAL_SECONDS=300
